{
  "name": "backrooms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "python tools/build.py",
    "build": "python tools/build.py --build",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "lint": "biome lint .",
    "prepare": "node tools/prepare.mjs",
    "check:glb": "node tools/check_glb.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "lefthook": "2.2.2"
  }
}
